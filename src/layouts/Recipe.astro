---
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Mermaid from '../components/Mermaid.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  authorUrl?: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  readingTime?: string;
  tags: string[];
  stack: string[];
  diagram?: string;
  diagramAlt?: string;
  diagramImage?: string;
  code?: string;
}

const {
  title, description, pubDate, updatedDate, author, authorUrl,
  difficulty, readingTime, tags, stack, diagram, diagramAlt, diagramImage, code,
} = Astro.props;
---

<Base title={title} description={description}>
  <article class="recipe">
    <div class="meta">
      <h1>{title}</h1>
      <p class="muted" style="font-size:1.05rem;">{description}</p>

      <div class="byline sans">
        <span>By {authorUrl ? <a href={authorUrl}>{author}</a> : author}</span>
        <span>·</span>
        <FormattedDate date={pubDate} />
        {updatedDate && <span class="muted"> · updated <FormattedDate date={updatedDate} /></span>}
        <span class={`pill pill-${difficulty}`}>{difficulty}</span>
        {readingTime && <span class="muted">· {readingTime}</span>}
      </div>

      {stack.length > 0 && (
        <p class="tags" style="margin-top:0.5rem;">
          {stack.map((s) => <span class="stack-chip">{s}</span>)}
        </p>
      )}
      {tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => <a href={`/tags/${t}`}>#{t}</a>)}
        </p>
      )}

      {code && (
        <div class="code-callout">
          📦 <strong>Runnable code:</strong> <a href={code}>{code.replace('https://', '')}</a>
        </div>
      )}
    </div>

    {diagram && <Mermaid chart={diagram} alt={diagramAlt} />}
    {diagramImage && (
      <figure class="diagram">
        <img src={diagramImage} alt={diagramAlt ?? title} style="max-width:100%;border-radius:8px;border:1px solid var(--color-border);" />
        {diagramAlt && <figcaption class="muted sans" style="font-size:0.85rem;margin-top:0.5rem;text-align:center;">{diagramAlt}</figcaption>}
      </figure>
    )}

    <slot />
  </article>
</Base>

<style>
  .byline {
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .pill {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
  }
  .pill-beginner { color: #15803d; }
  .pill-intermediate { color: #b45309; }
  .pill-advanced { color: #b1361e; }
  .stack-chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1rem 0.45rem;
    margin-right: 0.35rem;
    color: var(--color-muted);
  }
</style>
