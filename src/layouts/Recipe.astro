---
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Mermaid from '../components/Mermaid.astro';
import TOC from '../components/TOC.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  authorUrl?: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  readingTime?: string;
  tags: string[];
  stack: string[];
  diagram?: string;
  diagramAlt?: string;
  diagramImage?: string;
  code?: string;
  headings?: { depth: number; slug: string; text: string }[];
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
}

const {
  title, description, pubDate, updatedDate, author, authorUrl,
  difficulty, readingTime, tags, stack, diagram, diagramAlt, diagramImage, code,
  headings = [], prev, next,
} = Astro.props;
const initials = author.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---

<Base title={title} description={description}>
  <article class="recipe">
    <div class="meta">
      <h1>{title}</h1>
      <p class="lede">{description}</p>

      <div class="byline">
        <span>By {authorUrl ? <a href={authorUrl}>{author}</a> : author}</span>
        <span>·</span>
        <FormattedDate date={pubDate} />
        {updatedDate && <span> · updated <FormattedDate date={updatedDate} /></span>}
        <span class={`pill pill-${difficulty}`}>{difficulty}</span>
        {readingTime && <span class="faint">{readingTime}</span>}
      </div>

      {stack.length > 0 && (
        <p style="margin-top:.7rem;">
          {stack.map((s) => <span class="stack-chip">{s}</span>)}
        </p>
      )}
      {tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => <a href={`/tags/${t}`}>#{t}</a>)}
        </p>
      )}

      {code && (
        <div class="code-callout">
          📦 <strong>Runnable code for this recipe:</strong> <a href={code}>{code.replace('https://github.com/', '')}</a>
        </div>
      )}
    </div>

    {diagram && <Mermaid chart={diagram} alt={diagramAlt} />}
    {diagramImage && (
      <figure class="diagram">
        <img src={diagramImage} alt={diagramAlt ?? title} style="max-width:100%;border-radius:8px;" />
        {diagramAlt && <figcaption>{diagramAlt}</figcaption>}
      </figure>
    )}

    <TOC headings={headings} />

    <slot />

    <div class="authorbox">
      <div class="avatar">{initials}</div>
      <div>
        <div class="a-name">{author}</div>
        <div class="a-bio">Writes Applied GenAI — practical recipes for building with generative AI. Code lives in the <a href="https://github.com/mohitkmittal/applied-genai-cookbook">cookbook</a>.</div>
      </div>
    </div>

    {(prev || next) && (
      <nav class="recipe-nav">
        <span>{prev && <a href={`/recipes/${prev.slug}`}>← {prev.title}</a>}</span>
        <span>{next && <a href={`/recipes/${next.slug}`}>{next.title} →</a>}</span>
      </nav>
    )}
  </article>
</Base>

<style>
  .byline { align-items: center; }
</style>
