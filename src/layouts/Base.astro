---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} — recipes for building with generative AI`;
const pageDesc = description ?? SITE_DESCRIPTION;
const canonical = new URL(Astro.url.pathname, Astro.site);
const container = wide ? 'wrap-wide' : 'wrap';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site">
      <div class="wrap-wide">
        <a class="brand" href="/"><span class="dot"></span>Applied&nbsp;GenAI</a>
        <nav>
          <a href="/">Recipes</a>
          <a href="/about">About</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main class={container}>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap-wide">
        <span>© {new Date().getFullYear()} Applied GenAI · by Mohit Mittal</span>
        <span><a href="/rss.xml">RSS</a> · <a href="https://github.com/mohitkmittal/applied-genai-cookbook">Cookbook on GitHub</a></span>
      </div>
    </footer>
  </body>
</html>
