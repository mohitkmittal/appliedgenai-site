---
// Renders a table of contents from the MDX headings Astro extracts.
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---
{items.length > 2 && (
  <nav class="toc" aria-label="Table of contents">
    <div class="toc-label">In this recipe</div>
    <ol>
      {items.map((h) => (
        <li><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}
