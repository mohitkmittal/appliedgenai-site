---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';

const recipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base>
  <section class="hero">
    <span class="eyebrow">Applied GenAI</span>
    <h1>Recipes for building with generative AI.</h1>
    <p>Practical, opinionated patterns that hold up in production — agent harnesses,
       spec-driven development, memory, and prompts. Each one comes with a diagram and
       runnable code.</p>
  </section>

  <div class="section-label">All recipes</div>
  <div class="card-grid">
    {recipes.map((r) => (
      <a class="rcard" href={`/recipes/${r.slug}`}>
        <h3>{r.data.title}</h3>
        <p>{r.data.description}</p>
        <div class="row">
          <span class={`pill pill-${r.data.difficulty}`}>{r.data.difficulty}</span>
          {r.data.readingTime && <span class="faint">{r.data.readingTime}</span>}
          <span class="faint">·</span>
          {r.data.tags.slice(0, 3).map((t) => <span class="faint">#{t}</span>)}
          <span style="margin-left:auto"><FormattedDate date={r.data.pubDate} /></span>
        </div>
      </a>
    ))}
  </div>
</Base>
